/*--------------------------------*- C++ -*----------------------------------*\
| Reference: docs/02_phase2_cfd_rom.md § 2.2 + cases/case02_zigzag_channel/   |
|            README.md.                                                       |
|                                                                             |
| Skeleton blockMeshDict: a coarse outer block that bounds the zigzag         |
| channel. The actual zigzag walls are NOT generated here — the geometry is   |
| introduced as an STL via snappyHexMesh. Until src/tools/cad/zigzag.py emits |
| `constant/triSurface/zigzag_channel.stl`, snappyHexMesh has nothing to cut  |
| against and the case will degrade to a straight rectangular channel.       |
| That is acceptable for plumbing tests; flag in the CFD report.             |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale 0.001;   // mm → m

// One full zigzag wavelength: 14 mm period × 2 mm channel × 4 mm bounding box height
vertices
(
    (-2   -2   -2)     // 0
    (16   -2   -2)     // 1
    (16    4   -2)     // 2
    (-2    4   -2)     // 3
    (-2   -2    2)     // 4
    (16   -2    2)     // 5
    (16    4    2)     // 6
    (-2    4    2)     // 7
);

blocks
(
    // Background hex block — snappyHexMesh refines/cuts against the zigzag STL.
    hex (0 1 2 3 4 5 6 7) (180 60 40) simpleGrading (1 1 1)
);

boundary
(
    inlet
    {
        type patch;
        faces ((0 4 7 3));
    }
    outlet
    {
        type patch;
        faces ((1 2 6 5));
    }
    sides
    {
        type wall;
        faces
        (
            (0 1 5 4)
            (3 7 6 2)
            (0 3 2 1)
            (4 5 6 7)
        );
    }
);

mergePatchPairs ();

// ************************************************************************* //

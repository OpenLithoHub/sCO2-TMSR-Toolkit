/*--------------------------------*- C++ -*----------------------------------*\
| Cloned from case01_straight_channel/system/fvSchemes — same RAS/PIMPLE       |
| discretisation. Bumped div(phi,h) to limitedLinear because the zigzag        |
| bends produce sharper enthalpy gradients near the bend apex.                |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         Euler;
}

gradSchemes
{
    default         Gauss linear;
    grad(U)         cellLimited Gauss linear 1;
}

divSchemes
{
    default                          none;
    div(phi,U)                       Gauss linearUpwindV grad(U);
    div(phi,K)                       Gauss linear;
    div(phi,h)                       Gauss limitedLinear 1;
    div(phi,k)                       Gauss upwind;
    div(phi,omega)                   Gauss upwind;
    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

// ************************************************************************* //

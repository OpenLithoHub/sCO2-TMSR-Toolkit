FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState perfectGas;     // PLACEHOLDER — replace with sCO2 LUT
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight   44.01;          // g/mol — CO2
    }
    thermodynamics
    {
        Cp          5000;           // J/kg·K — illustrative; sCO2 Cp varies wildly
        Hf          0;
    }
    transport
    {
        mu          3e-5;           // Pa·s — placeholder
        Pr          1.0;            // Prandtl placeholder
    }
}


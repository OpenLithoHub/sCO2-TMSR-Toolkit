    inlet       { type fixedFluxPressure; value uniform 8e6; }
    outlet      { type fixedValue;        value uniform 7.95e6; }
    sides       { type fixedFluxPressure; value uniform 8e6; }
    zigzag_wall { type fixedFluxPressure; value uniform 8e6; }
}

/*--------------------------------*- C++ -*----------------------------------*\
| fvSolution for case03 LES — tighter PIMPLE coupling and small relaxation.   |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "rho.*"     { solver PCG; preconditioner DIC; tolerance 0; relTol 0; }
    "p_rgh"
    {
        solver           GAMG;
        smoother         GaussSeidel;
        tolerance        1e-8;
        relTol           0.005;
    }
    "p_rghFinal" { $p_rgh; relTol 0; }
    "(U|h|k)"
    {
        solver           PBiCGStab;
        preconditioner   DILU;
        tolerance        1e-8;
        relTol           0.05;
    }
    "(U|h|k)Final" { $U; relTol 0; }
}

PIMPLE
{
    momentumPredictor   yes;
    nOuterCorrectors    2;
    nCorrectors         3;
    nNonOrthogonalCorrectors 1;
    pRefCell            0;
    pRefValue           0;
}

relaxationFactors
{
    fields  { ".*" 1.0; }   // LES — no relaxation
    equations { ".*" 1.0; }
}

// ************************************************************************* //

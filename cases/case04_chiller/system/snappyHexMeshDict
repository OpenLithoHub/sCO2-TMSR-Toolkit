/*--------------------------------*- C++ -*----------------------------------*\
| snappyHexMesh: cut the helical tube + shell out of the background mesh.     |
| Requires the two STLs produced by                                           |
|   `python -m tools.cad.helical_coil`                                        |
| under `constant/triSurface/`:                                               |
|   helical_tube.stl   — gas-side tube outer wall (38.1 mm OD)                |
|   chiller_shell.stl  — coaxial shell outer cylinder                         |
| and the two .eMesh feature files produced by `surfaceFeatureExtract`        |
| (see system/surfaceFeatureExtractDict).                                     |
|                                                                             |
| Reference: docs/02_phase2_cfd_rom.md § 2.5 +                                |
|            docs/data_extracts/wright2010_sand2010-0171.md "Table 3.2".      |
|                                                                             |
| Refinement: production grade — tube_wall (3 4), shell_wall (2 3).           |
| Surface layers active on the tube wall (boundary-layer resolution on the    |
| heat-transfer surface). Smoke-test runs can drop layers via Allrun env.     |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       false;     // smoke-test: layer addition uses too much memory in
                           // the 8 GB Docker default; flip to true for
                           // production (and bump container memory to ≥16 GB).

geometry
{
    helical_tube.stl
    {
        type triSurfaceMesh;
        name tube_wall;
        // helical_coil.py emits STL in metres by default (--out-units m),
        // matching the metres-resolved background mesh from
        // blockMeshDict (scale 0.001 applied to its mm coordinates).
        // No scale entry here — snappyHexMesh consumes STL in raw units.
    }
    chiller_shell.stl
    {
        type triSurfaceMesh;
        name shell_wall;
    }
}

castellatedMeshControls
{
    maxLocalCells       2000000;
    maxGlobalCells      4000000;
    minRefinementCells  10;
    nCellsBetweenLevels 3;
    resolveFeatureAngle 30;
    features
    (
        {
            file   "helical_tube.eMesh";
            level  3;
        }
        {
            file   "chiller_shell.eMesh";
            level  1;
        }
    );
    refinementSurfaces
    {
        tube_wall
        {
            // Smoke-test: (2 3). Production: bump to (3 4) for the dominant
            // heat-transfer surface — needs ~16 GB of container memory at
            // the default 40×40×128 background block.
            //
            // faceZone tube_wall   → tube/shell interface; splitMeshRegions
            //                        turns it into the regionCoupling pair
            //                        tube_wall_gas / tube_wall_liquid.
            //
            // cellZone gas + cellZoneInside insidePoint:
            //   helical_tube.stl is now CLOSED (the swept ring has fan-
            //   triangulated end caps — see helical_coil.py
            //   build_tube_stl(with_endcaps=True), confirmed by
            //   `surfaceCheck` reporting "Surface is closed. All edges
            //   connected to two faces."). This lets snappy use the
            //   point-in-polygon test to tag the tube interior directly,
            //   which is far more robust than the flood-fill from
            //   locationsInMesh (which assigns by mesh connectivity and
            //   was leaving the gas seed in the same topological region as
            //   the liquid seed when the helix STL chopped the background
            //   into 11 disconnected pieces).
            level             (2 3);
            faceZone          tube_wall;
            cellZone          gas;
            cellZoneInside    insidePoint;
            insidePoint       (0.190 0.062 0.005);
            patchInfo         { type wall; }
        }
        shell_wall
        {
            // Shell is a straight cylinder; (1 2) is enough for smoke.
            level (1 2);
            patchInfo { type wall; }
        }
    }
    refinementRegions
    {
        // Volume-based refinement inside the tube would require a closed STL
        // (mode inside relies on point-in-polygon). helical_tube.stl is the
        // open swept-ring surface, so we let surface refinement on
        // refinementSurfaces.tube_wall (level 3 4) carry the gas-side
        // resolution. Bumping background blockMeshDict density is the
        // alternative if the gas-side bulk needs to be finer.
    }
    // Multi-region partitioning:
    //  - gas cellZone is set DIRECTLY on refinementSurfaces.tube_wall via
    //    cellZoneInside insidePoint (now possible because helical_tube.stl
    //    has end caps — see build_tube_stl(with_endcaps=True)).
    //  - liquid cellZone is seeded here. The shell-side annulus midpoint
    //    sits at (0.220, 0, 0.760) — between coil_radius=200 mm and the
    //    shell wall at ≈233 mm, mid-height of the helix.
    //  splitMeshRegions -cellZones turns the `tube_wall` faceZone into the
    //  regionCoupling pair tube_wall_gas / tube_wall_liquid.
    locationsInMesh
    (
        ((0.220 0.0 0.760) liquid)
    );
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch         3;
    tolerance            2.0;
    nSolveIter           50;
    nRelaxIter           5;
    nFeatureSnapIter     15;
    implicitFeatureSnap  false;
    explicitFeatureSnap  true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes        true;
    layers
    {
        tube_wall { nSurfaceLayers 5; }
        shell_wall { nSurfaceLayers 2; }
    }
    expansionRatio       1.2;
    finalLayerThickness  0.4;
    minThickness         0.05;
    nGrow                0;
    featureAngle         60;
    nRelaxIter           5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals       3;
    nSmoothThickness     10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle   90;
    nBufferCellsNoExtrude 0;
    nLayerIter           50;
}

meshQualityControls
{
    maxNonOrtho         65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave          80;
    minVol              1e-13;
    minTetQuality       1e-15;
    minArea             -1;
    minTwist            0.05;
    minDeterminant      0.001;
    minFaceWeight       0.05;
    minVolRatio         0.01;
    minTriangleTwist    -1;
    nSmoothScale        4;
    errorReduction      0.75;
}

mergeTolerance 1e-6;

// ************************************************************************* //

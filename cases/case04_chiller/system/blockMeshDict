/*--------------------------------*- C++ -*----------------------------------*\
| Background mesh for snappyHexMesh on the helical-coil chiller.              |
| Reference: docs/02_phase2_cfd_rom.md § 2.5 +                                |
|            docs/data_extracts/wright2010_sand2010-0171.md "Table 3.2".      |
|                                                                             |
| The shell-side outer cylinder generated by                                  |
|   `python -m tools.cad.helical_coil`                                        |
| has radius R_shell ≈ 233.45 mm at default knobs (coil_radius 200 mm +       |
| tube_od/2 18.05 mm + shell_clearance 14.4 mm).                              |
|                                                                             |
| This block must enclose both STLs with margin. Bounds:                      |
|   x, y ∈ [-260, 260] mm                                                     |
|   z    ∈ [-60, 1600] mm   (helix runs 0 → N·pitch = 15 × 101.6 = 1524 mm)   |
|                                                                             |
| Cell count is sized for a smoke-test snappyHexMesh refinement; bump for     |
| production.                                                                 |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale 0.001;   // mm → m

vertices
(
    (-260 -260  -60)   // 0
    ( 260 -260  -60)   // 1
    ( 260  260  -60)   // 2
    (-260  260  -60)   // 3
    (-260 -260 1600)   // 4
    ( 260 -260 1600)   // 5
    ( 260  260 1600)   // 6
    (-260  260 1600)   // 7
);

blocks
(
    // Background hex resolution: ~13 mm cells laterally, ~13 mm axially.
    // snappyHexMesh refines around the STL to capture the tube wall.
    hex (0 1 2 3 4 5 6 7) (40 40 128) simpleGrading (1 1 1)
);

boundary
(
    inlet
    {
        type patch;
        faces ((0 1 2 3));
    }
    outlet
    {
        type patch;
        faces ((4 5 6 7));
    }
    sides
    {
        type wall;
        faces
        (
            (0 4 7 3)
            (1 2 6 5)
            (0 1 5 4)
            (3 7 6 2)
        );
    }
);

mergePatchPairs ();

// ************************************************************************* //

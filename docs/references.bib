@techreport{Humrickhouse2012_INL_EXT_11_23265,
  author      = {Humrickhouse, Paul and Pawelko, Robert and
                 Shimada, Masashi and Winston, Philip},
  title       = {Tritium Permeability of {Incoloy} 800{H} and {Inconel} 617},
  institution = {Idaho National Laboratory},
  number      = {INL/EXT-11-23265, Revision 1},
  year        = {2012},
  month       = jul,
  url         = {https://www.osti.gov/biblio/1056010},
  note        = {Primary US-public source for Inconel 617 / Incoloy
                 800H high-temperature tritium permeability anchored
                 to OSTI biblio 1056010. Table 1 collates literature
                 K0 / Q for hydrogen permeation across both alloys
                 (units cm^3 STP / (cm s atm^0.5); divide by 7.66e4
                 to convert to mol/(m s Pa^0.5)). FY-11 measured
                 tritium permeability of Inconel 617 was approximately
                 two orders of magnitude lower than the literature
                 hydrogen values, attributed to surface oxide barrier
                 (Cr2O3) — used in this repo as the empirical
                 Worst/Best envelope ratio (sec 4 / sec 5 conclusions).}
}

